{
  "expo": {
    "name": "WhatsApp",
    "slug": "whatsapp-web",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "whatsapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "name": "WhatsApp",
      "shortName": "WhatsApp",
      "description": "A WhatsApp-inspired messaging web app built with Expo and React Native.",
      "themeColor": "#00a884",
      "backgroundColor": "#111b21",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
